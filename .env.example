# Copy this file to .env and fill in values. .env is git-ignored - never commit it.
# Create API keys with WITHDRAWALS DISABLED and restrict them to your IP address.

# ===================== cryptobot =====================
# One key pair per Binance account/portfolio:  BINANCE_<ACCOUNT>_<ENVIRONMENT>_API_KEY
# <ACCOUNT> matches `account:` in config/config.yaml.

# Spot testnet keys from https://testnet.binance.vision (fake money)
BINANCE_SPOT_TESTNET_API_KEY=
BINANCE_SPOT_TESTNET_API_SECRET=

# Spot LIVE keys (real money) - leave empty until you deliberately go live
BINANCE_SPOT_LIVE_API_KEY=
BINANCE_SPOT_LIVE_API_SECRET=

# Later: margin / futures / copy-trading lead accounts, each with its own key, e.g.
# BINANCE_MARGIN_LIVE_API_KEY=
# BINANCE_MARGIN_LIVE_API_SECRET=
# BINANCE_FUTURES_LIVE_API_KEY=
# BINANCE_FUTURES_LIVE_API_SECRET=
# BINANCE_COPYLEAD_LIVE_API_KEY=
# BINANCE_COPYLEAD_LIVE_API_SECRET=

# Live-trading confirmation CRYPTOBOT_CONFIRM_LIVE: do NOT put it in this file
# (anything here is loaded on every run). Set it by hand, per terminal session -
# see README "Going live".

# Telegram (stub, not used yet)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ===================== freqtrade (docker-compose.yml) =====================
# Dry-run does not send real orders. Leave the keys empty until then.
BINANCE_API_KEY=
BINANCE_API_SECRET=
FREQTRADE_API_USERNAME=freqtrader
FREQTRADE_API_PASSWORD=change-me
FREQTRADE_JWT_SECRET=change-me
FREQTRADE_WS_TOKEN=change-me
